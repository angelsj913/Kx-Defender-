{
  "_comment": "KxSig built-in signature library (self-built, no external dependencies).",
  "_version": "1.0.0",
  "_categories": [
    "execution", "credential-access", "lolbas", "persistence",
    "discovery", "lateral-movement", "defense-evasion", "webshell",
    "ransomware", "recon", "c2", "phishing", "malware-strings",
    "supply-chain", "cloud-abuse", "lab-marker"
  ],
  "rules": [
    { "id": "KXSIG-001", "name": "powershell_encoded_command",         "severity": "high",     "category": "execution",         "patterns": ["(?i)powershell(\\.exe)?.*\\s-(enc(odedcommand)?|e|ec)\\s+[A-Za-z0-9+/=]{20,}"] },
    { "id": "KXSIG-002", "name": "powershell_frombase64",              "severity": "high",     "category": "execution",         "patterns": ["(?i)\\[convert\\]::frombase64string"] },
    { "id": "KXSIG-003", "name": "powershell_downloadstring",          "severity": "high",     "category": "execution",         "patterns": ["(?i)(new-object\\s+net\\.webclient|iwr|invoke-webrequest).*downloadstring", "(?i)\\.downloadstring\\(\\s*['\"]https?://"] },
    { "id": "KXSIG-004", "name": "powershell_iex_web",                 "severity": "critical", "category": "execution",         "patterns": ["(?i)iex\\s*\\(\\s*(new-object|iwr|invoke-webrequest|invoke-restmethod)"] },
    { "id": "KXSIG-005", "name": "powershell_hidden_window",           "severity": "medium",   "category": "defense-evasion",   "patterns": ["(?i)-w(indowstyle)?\\s+hidden", "(?i)-nop\\b.*-w\\s+hidden"] },
    { "id": "KXSIG-006", "name": "powershell_bypass_execution",        "severity": "medium",   "category": "defense-evasion",   "patterns": ["(?i)-executionpolicy\\s+bypass", "(?i)-ep\\s+bypass"] },
    { "id": "KXSIG-007", "name": "powershell_amsi_bypass_pattern",     "severity": "critical", "category": "defense-evasion",   "patterns": ["(?i)amsiInitFailed", "(?i)Set-MpPreference.*-DisableRealtimeMonitoring", "(?i)\\[Ref\\]\\.Assembly\\.GetType\\('System\\.Management\\.Automation\\.AmsiUtils'\\)"] },
    { "id": "KXSIG-008", "name": "powershell_invoke_expression_bracket", "severity": "medium", "category": "execution",         "patterns": ["(?i)&\\s*\\(?\\s*['\"]?iex['\"]?\\s*\\)?", "(?i)\\.\\s*Invoke\\s*\\(\\s*\\[System\\.Text"] },
    { "id": "KXSIG-009", "name": "powershell_reflection_load",         "severity": "high",     "category": "execution",         "patterns": ["(?i)\\[reflection\\.assembly\\]::load", "(?i)assembly\\]::gettype"] },
    { "id": "KXSIG-010", "name": "cmd_obfuscation_env",                "severity": "medium",   "category": "defense-evasion",   "patterns": ["(?i)%COMSPEC:~", "(?i)cmd(\\.exe)?\\s*/[cvk]\\s*.*\\^", "(?i)set\\s+\\w+=.*&&\\s*call\\s+%"] },
    { "id": "KXSIG-011", "name": "mimikatz_module_names",              "severity": "critical", "category": "credential-access", "patterns": ["(?i)sekurlsa::", "(?i)kerberos::", "(?i)lsadump::", "(?i)crypto::", "(?i)misc::skeleton"] },
    { "id": "KXSIG-012", "name": "mimikatz_logonpasswords",            "severity": "critical", "category": "credential-access", "patterns": ["(?i)privilege::debug.*sekurlsa::logonpasswords", "(?i)mimikatz.*logonpasswords"] },
    { "id": "KXSIG-013", "name": "lsass_dump_procdump",                "severity": "critical", "category": "credential-access", "patterns": ["(?i)procdump.*-ma\\s+lsass", "(?i)procdump64?\\.exe.*lsass"] },
    { "id": "KXSIG-014", "name": "lsass_dump_comsvcs",                 "severity": "critical", "category": "credential-access", "patterns": ["(?i)rundll32(\\.exe)?\\s+comsvcs\\.dll,\\s*minidump", "(?i)MiniDump\\s+\\d+\\s+.*\\.dmp"] },
    { "id": "KXSIG-015", "name": "dcsync_replicate",                   "severity": "critical", "category": "credential-access", "patterns": ["(?i)DS-Replication-Get-Changes", "(?i)lsadump::dcsync"] },
    { "id": "KXSIG-016", "name": "kerberoast_request",                 "severity": "high",     "category": "credential-access", "patterns": ["(?i)Add-Type.*System\\.IdentityModel.*KerberosRequestorSecurityToken", "(?i)Rubeus.*kerberoast"] },
    { "id": "KXSIG-017", "name": "asrep_roast",                        "severity": "high",     "category": "credential-access", "patterns": ["(?i)Rubeus.*asreproast", "(?i)Get-ASREPHash"] },
    { "id": "KXSIG-018", "name": "dpapi_extract",                      "severity": "high",     "category": "credential-access", "patterns": ["(?i)dpapi::(masterkey|cred|chrome|vault)", "(?i)Invoke-DPAPI"] },
    { "id": "KXSIG-019", "name": "chrome_cookie_theft_path",           "severity": "high",     "category": "credential-access", "patterns": ["(?i)Google\\\\Chrome\\\\User Data\\\\.*Cookies", "(?i)AppData.*Local.*Chrome.*Login Data"] },
    { "id": "KXSIG-020", "name": "firefox_cred_files",                 "severity": "medium",   "category": "credential-access", "patterns": ["(?i)Mozilla\\\\Firefox\\\\Profiles.*(logins\\.json|key\\d+\\.db)"] },
    { "id": "KXSIG-021", "name": "lolbas_certutil_download",           "severity": "high",     "category": "lolbas",            "patterns": ["(?i)certutil(\\.exe)?\\s+.*-urlcache.*https?://", "(?i)certutil(\\.exe)?\\s+.*-verifyctl.*https?://"] },
    { "id": "KXSIG-022", "name": "lolbas_bitsadmin_download",          "severity": "high",     "category": "lolbas",            "patterns": ["(?i)bitsadmin(\\.exe)?\\s+/(transfer|create|addfile).*https?://"] },
    { "id": "KXSIG-023", "name": "lolbas_mshta_url",                   "severity": "high",     "category": "lolbas",            "patterns": ["(?i)mshta(\\.exe)?\\s+(https?://|javascript:|vbscript:)"] },
    { "id": "KXSIG-024", "name": "lolbas_regsvr32_scrobj",             "severity": "high",     "category": "lolbas",            "patterns": ["(?i)regsvr32(\\.exe)?\\s+.*(/s\\s+)?(/i:)?https?://.*scrobj\\.dll", "(?i)regsvr32.*scrobj"] },
    { "id": "KXSIG-025", "name": "lolbas_wmic_process",                "severity": "medium",   "category": "lolbas",            "patterns": ["(?i)wmic(\\.exe)?\\s+process\\s+call\\s+create", "(?i)wmic\\s+/node:"] },
    { "id": "KXSIG-026", "name": "lolbas_installutil_dll",             "severity": "high",     "category": "lolbas",            "patterns": ["(?i)installutil(\\.exe)?\\s+/logfile=\\s+/logtoconsole=false"] },
    { "id": "KXSIG-027", "name": "lolbas_msbuild_inline_task",         "severity": "high",     "category": "lolbas",            "patterns": ["(?i)msbuild(\\.exe)?\\s+.*\\.xml", "(?i)UsingTask.*TaskFactory=\"CodeTaskFactory\""] },
    { "id": "KXSIG-028", "name": "lolbas_rundll32_javascript",         "severity": "high",     "category": "lolbas",            "patterns": ["(?i)rundll32(\\.exe)?\\s+javascript:", "(?i)rundll32.*RunHTMLApplication"] },
    { "id": "KXSIG-029", "name": "lolbas_odbcconf_regsvr",             "severity": "medium",   "category": "lolbas",            "patterns": ["(?i)odbcconf(\\.exe)?\\s+/A\\s+\\{REGSVR"] },
    { "id": "KXSIG-030", "name": "lolbas_forfiles_cmd",                "severity": "medium",   "category": "lolbas",            "patterns": ["(?i)forfiles(\\.exe)?\\s+/p\\s+.*\\s+/c\\s+\"cmd"] },
    { "id": "KXSIG-031", "name": "persist_registry_run",               "severity": "high",     "category": "persistence",       "patterns": ["(?i)HKCU\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run", "(?i)HKLM\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run", "(?i)reg\\s+add\\s+.*\\\\CurrentVersion\\\\Run"] },
    { "id": "KXSIG-032", "name": "persist_scheduled_task_create",      "severity": "medium",   "category": "persistence",       "patterns": ["(?i)schtasks(\\.exe)?\\s+/create.*/tn\\s+", "(?i)Register-ScheduledTask.*-Action"] },
    { "id": "KXSIG-033", "name": "persist_wmi_event_subscription",     "severity": "critical", "category": "persistence",       "patterns": ["(?i)ROOT\\\\subscription", "(?i)__EventFilter\\b.*__EventConsumer"] },
    { "id": "KXSIG-034", "name": "persist_service_create",             "severity": "medium",   "category": "persistence",       "patterns": ["(?i)sc(\\.exe)?\\s+create\\s+\\S+\\s+.*binpath=", "(?i)New-Service\\s+-Name"] },
    { "id": "KXSIG-035", "name": "persist_startup_folder",             "severity": "medium",   "category": "persistence",       "patterns": ["(?i)Start Menu\\\\Programs\\\\Startup\\\\.*\\.(lnk|vbs|bat|ps1)"] },
    { "id": "KXSIG-036", "name": "persist_appinit_dlls",               "severity": "high",     "category": "persistence",       "patterns": ["(?i)AppInit_DLLs"] },
    { "id": "KXSIG-037", "name": "persist_image_hijack_debugger",      "severity": "high",     "category": "persistence",       "patterns": ["(?i)Image File Execution Options\\\\.*Debugger"] },
    { "id": "KXSIG-038", "name": "discover_whoami",                    "severity": "low",      "category": "discovery",         "patterns": ["(?i)\\bwhoami(\\.exe)?\\s+(/all|/priv|/groups)"] },
    { "id": "KXSIG-039", "name": "discover_net_view",                  "severity": "low",      "category": "discovery",         "patterns": ["(?i)\\bnet(\\.exe)?\\s+(view|user|group)\\s+/domain"] },
    { "id": "KXSIG-040", "name": "discover_bloodhound",                "severity": "high",     "category": "discovery",         "patterns": ["(?i)SharpHound", "(?i)Invoke-BloodHound"] },
    { "id": "KXSIG-041", "name": "discover_adfind",                    "severity": "medium",   "category": "discovery",         "patterns": ["(?i)adfind(\\.exe)?\\s+-f\\s+"] },
    { "id": "KXSIG-042", "name": "discover_powerview",                 "severity": "medium",   "category": "discovery",         "patterns": ["(?i)PowerView", "(?i)Get-NetDomain", "(?i)Get-NetGroupMember", "(?i)Find-DomainShare"] },
    { "id": "KXSIG-043", "name": "discover_nltest_domain",             "severity": "low",      "category": "discovery",         "patterns": ["(?i)nltest(\\.exe)?\\s+/(dclist|dsgetdc|domain_trusts)"] },
    { "id": "KXSIG-044", "name": "lm_psexec_binary",                   "severity": "high",     "category": "lateral-movement",  "patterns": ["(?i)psexec(64)?(\\.exe)?\\s+\\\\\\\\\\S+", "(?i)PsExec-based"] },
    { "id": "KXSIG-045", "name": "lm_wmic_remote",                     "severity": "high",     "category": "lateral-movement",  "patterns": ["(?i)wmic\\s+/node:\\S+\\s+process\\s+call\\s+create"] },
    { "id": "KXSIG-046", "name": "lm_winrs_remote",                    "severity": "medium",   "category": "lateral-movement",  "patterns": ["(?i)winrs(\\.exe)?\\s+-r:"] },
    { "id": "KXSIG-047", "name": "lm_pass_the_hash",                   "severity": "critical", "category": "lateral-movement",  "patterns": ["(?i)sekurlsa::pth\\s+/user:", "(?i)Invoke-TheHash"] },
    { "id": "KXSIG-048", "name": "lm_smbexec_wmiexec",                 "severity": "high",     "category": "lateral-movement",  "patterns": ["(?i)smbexec\\.py", "(?i)wmiexec\\.py", "(?i)dcomexec\\.py"] },
    { "id": "KXSIG-049", "name": "evasion_disable_defender",           "severity": "critical", "category": "defense-evasion",   "patterns": ["(?i)Set-MpPreference\\s+-Disable(Realtime|Behavior|BlockAtFirstSeen)", "(?i)Add-MpPreference\\s+-ExclusionPath"] },
    { "id": "KXSIG-050", "name": "evasion_disable_firewall",           "severity": "high",     "category": "defense-evasion",   "patterns": ["(?i)netsh\\s+advfirewall\\s+set\\s+allprofiles\\s+state\\s+off", "(?i)Set-NetFirewallProfile\\s+-Enabled\\s+False"] },
    { "id": "KXSIG-051", "name": "evasion_clear_eventlog",             "severity": "critical", "category": "defense-evasion",   "patterns": ["(?i)wevtutil\\s+cl\\s+", "(?i)Clear-EventLog", "(?i)Remove-EventLog"] },
    { "id": "KXSIG-052", "name": "evasion_disable_uac",                "severity": "high",     "category": "defense-evasion",   "patterns": ["(?i)EnableLUA.*0", "(?i)ConsentPromptBehaviorAdmin.*0"] },
    { "id": "KXSIG-053", "name": "webshell_php_eval",                  "severity": "critical", "category": "webshell",          "patterns": ["<\\?php\\s+.*(eval|assert|system|exec|passthru|shell_exec)\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)"] },
    { "id": "KXSIG-054", "name": "webshell_php_preg_replace_e",        "severity": "critical", "category": "webshell",          "patterns": ["(?i)preg_replace\\s*\\([^,]*['\"]/e['\"]"] },
    { "id": "KXSIG-055", "name": "webshell_asp_execute",               "severity": "critical", "category": "webshell",          "patterns": ["(?i)<%\\s*eval\\s*\\(?request", "(?i)Server\\.CreateObject\\(['\"]?Wscript\\.Shell"] },
    { "id": "KXSIG-056", "name": "webshell_jsp_runtime_exec",          "severity": "critical", "category": "webshell",          "patterns": ["(?i)Runtime\\.getRuntime\\(\\)\\.exec\\s*\\(\\s*request\\.getParameter"] },
    { "id": "KXSIG-057", "name": "webshell_china_chopper",             "severity": "critical", "category": "webshell",          "patterns": ["(?i)<%@\\s*Page\\s+Language=\"Jscript\".*eval\\s*\\(\\s*Request", "(?i)\\?php\\s+@eval\\s*\\(\\s*\\$_POST\\[['\"]\\w+['\"]\\]\\s*\\)\\s*;\\s*\\?>"] },
    { "id": "KXSIG-058", "name": "ransomware_extension_batch",         "severity": "critical", "category": "ransomware",        "patterns": ["(?i)\\.locky\\b|\\.wncry\\b|\\.wcry\\b|\\.crypt\\b|\\.encrypt\\b|\\.locked\\b|\\.crypted\\b|\\.ryk\\b|\\.conti\\b"] },
    { "id": "KXSIG-059", "name": "ransomware_note_files",              "severity": "high",     "category": "ransomware",        "patterns": ["(?i)READ_?ME.*(txt|html|url)$", "(?i)HOW_TO_DECRYPT", "(?i)_readme\\.txt", "(?i)DECRYPT_INSTRUCTIONS"] },
    { "id": "KXSIG-060", "name": "ransomware_vssadmin_delete",         "severity": "critical", "category": "ransomware",        "patterns": ["(?i)vssadmin(\\.exe)?\\s+delete\\s+shadows", "(?i)wmic\\s+shadowcopy\\s+delete"] },
    { "id": "KXSIG-061", "name": "ransomware_wbadmin_delete",          "severity": "high",     "category": "ransomware",        "patterns": ["(?i)wbadmin(\\.exe)?\\s+delete\\s+(catalog|backup|systemstatebackup)"] },
    { "id": "KXSIG-062", "name": "ransomware_bcdedit_recovery",        "severity": "high",     "category": "ransomware",        "patterns": ["(?i)bcdedit(\\.exe)?\\s+/set.*recoveryenabled\\s+no", "(?i)bcdedit.*bootstatuspolicy\\s+ignoreallfailures"] },
    { "id": "KXSIG-063", "name": "ransomware_disable_recycle_bin",     "severity": "medium",   "category": "ransomware",        "patterns": ["(?i)cipher(\\.exe)?\\s+/w"] },
    { "id": "KXSIG-064", "name": "malware_metasploit_signature",       "severity": "high",     "category": "malware-strings",   "patterns": ["metsvc\\.exe", "meterpreter", "(?i)msfvenom\\s+-p"] },
    { "id": "KXSIG-065", "name": "malware_cobaltstrike_beacon",        "severity": "critical", "category": "c2",                "patterns": ["(?i)beacon\\.(dll|exe|x64\\.dll)", "(?i)Cobalt Strike", "(?i)stager_x?86", "MZARUH¡"] },
    { "id": "KXSIG-066", "name": "malware_empire_agent",               "severity": "high",     "category": "c2",                "patterns": ["(?i)PowerShellEmpire", "(?i)Invoke-Empire"] },
    { "id": "KXSIG-067", "name": "malware_havoc_string",               "severity": "high",     "category": "c2",                "patterns": ["(?i)HavocFramework", "(?i)Demon\\.x64\\."] },
    { "id": "KXSIG-068", "name": "malware_sliver_string",              "severity": "high",     "category": "c2",                "patterns": ["(?i)sliver-server", "(?i)implant\\.go\\b"] },
    { "id": "KXSIG-069", "name": "malware_reverse_shell_bash",         "severity": "critical", "category": "malware-strings",   "patterns": ["bash\\s+-i\\s+>&\\s*/dev/tcp/[\\d.]+/\\d+"] },
    { "id": "KXSIG-070", "name": "malware_reverse_shell_python",       "severity": "critical", "category": "malware-strings",   "patterns": ["(?i)python\\s+-c\\s+['\"]import\\s+socket.*subprocess.*os\\.dup2"] },
    { "id": "KXSIG-071", "name": "malware_reverse_shell_nc",           "severity": "high",     "category": "malware-strings",   "patterns": ["(?i)\\bnc(\\.exe)?\\s+-[el]v?p\\s+\\d+", "(?i)ncat(\\.exe)?\\s+-e\\s+/bin/"] },
    { "id": "KXSIG-072", "name": "malware_msfvenom_shellcode",         "severity": "high",     "category": "malware-strings",   "patterns": ["\\\\xfc\\\\xe8\\\\x8[0-9a-f]", "(?i)shellcode\\s*=\\s*b['\"]\\\\x"] },
    { "id": "KXSIG-073", "name": "c2_dns_tunneling_pattern",           "severity": "high",     "category": "c2",                "patterns": ["(?i)([a-f0-9]{16,})\\.[a-z0-9-]+\\.[a-z]{2,}"] },
    { "id": "KXSIG-074", "name": "c2_domain_generation_algorithm",     "severity": "medium",   "category": "c2",                "patterns": ["(?i)([a-z]{15,30})\\.(top|xyz|club|tk|ml)\\b"] },
    { "id": "KXSIG-075", "name": "phishing_html_smuggling",            "severity": "high",     "category": "phishing",          "patterns": ["(?i)var\\s+\\w+\\s*=\\s*['\"](data:application/(x-msdownload|octet-stream);base64,)", "(?i)Blob\\(\\[.*\\]\\s*,\\s*\\{\\s*type\\s*:\\s*['\"]application/octet-stream"] },
    { "id": "KXSIG-076", "name": "phishing_url_shortener_typo",        "severity": "low",      "category": "phishing",          "patterns": ["(?i)https?://(bit\\.ly|goo\\.gl|tinyurl\\.com|t\\.co|is\\.gd|ow\\.ly)/\\w{4,}"] },
    { "id": "KXSIG-077", "name": "supply_chain_typosquat_npm",         "severity": "high",     "category": "supply-chain",      "patterns": ["(?i)\\\"name\\\":\\s*\\\"(cross-envs|lodahs|expresss|jquerry|node-ipcs|ua-parse-js)\\\""] },
    { "id": "KXSIG-078", "name": "supply_chain_postinstall_curl",      "severity": "high",     "category": "supply-chain",      "patterns": ["(?i)\\\"postinstall\\\":\\s*\\\"(curl|wget)\\s+https?://"] },
    { "id": "KXSIG-079", "name": "cloud_aws_secret_access_key",        "severity": "critical", "category": "cloud-abuse",       "patterns": ["AKIA[0-9A-Z]{16}", "(?i)aws_secret_access_key\\s*=\\s*['\"][A-Za-z0-9/+=]{40}['\"]"] },
    { "id": "KXSIG-080", "name": "cloud_gcp_service_account_key",      "severity": "critical", "category": "cloud-abuse",       "patterns": ["\"type\":\\s*\"service_account\".*\"private_key\":\\s*\"-----BEGIN PRIVATE KEY"] },
    { "id": "KXSIG-081", "name": "cloud_azure_client_secret",          "severity": "high",     "category": "cloud-abuse",       "patterns": ["(?i)client_secret\\s*=\\s*['\"][A-Za-z0-9~._-]{34,}['\"]"] },
    { "id": "KXSIG-082", "name": "cloud_slack_token",                  "severity": "critical", "category": "cloud-abuse",       "patterns": ["xox[baprs]-[A-Za-z0-9-]{10,}"] },
    { "id": "KXSIG-083", "name": "cloud_github_token",                 "severity": "critical", "category": "cloud-abuse",       "patterns": ["ghp_[A-Za-z0-9]{36}", "ghs_[A-Za-z0-9]{36}", "gho_[A-Za-z0-9]{36}", "github_pat_[A-Za-z0-9_]{82}"] },
    { "id": "KXSIG-084", "name": "cloud_stripe_secret",                "severity": "critical", "category": "cloud-abuse",       "patterns": ["sk_(test|live)_[A-Za-z0-9]{24,}"] },
    { "id": "KXSIG-085", "name": "cloud_openai_key",                   "severity": "high",     "category": "cloud-abuse",       "patterns": ["sk-[A-Za-z0-9]{20,}", "sk-proj-[A-Za-z0-9_-]{20,}"] },
    { "id": "KXSIG-086", "name": "cloud_anthropic_key",                "severity": "high",     "category": "cloud-abuse",       "patterns": ["sk-ant-[A-Za-z0-9_-]{20,}"] },
    { "id": "KXSIG-087", "name": "cred_private_key_block",             "severity": "critical", "category": "credential-access", "patterns": ["-----BEGIN\\s+(RSA|EC|OPENSSH|DSA|PGP)\\s+PRIVATE KEY-----"] },
    { "id": "KXSIG-088", "name": "cred_htpasswd_line",                 "severity": "medium",   "category": "credential-access", "patterns": ["^[A-Za-z0-9._-]+:\\$(2[abxy]|apr1|1|5|6)\\$"] },
    { "id": "KXSIG-089", "name": "cred_generic_password_dict",         "severity": "low",      "category": "credential-access", "patterns": ["(?i)['\"]?password['\"]?\\s*[:=]\\s*['\"](admin|password|123456|qwerty|letmein|changeme|toor)['\"]"] },
    { "id": "KXSIG-090", "name": "recon_masscan_flags",                "severity": "medium",   "category": "recon",             "patterns": ["(?i)masscan\\s+.*-p\\s*\\d+", "(?i)--rate=\\s*\\d{4,}"] },
    { "id": "KXSIG-091", "name": "recon_nmap_scripts",                 "severity": "low",      "category": "recon",             "patterns": ["(?i)nmap\\s+.*(--script\\s+(vuln|exploit|auth-*|smb-vuln-*)|-sS\\s+-p-)"] },
    { "id": "KXSIG-092", "name": "recon_gobuster_dirbust",             "severity": "low",      "category": "recon",             "patterns": ["(?i)gobuster\\s+(dir|dns|vhost)\\s+"] },
    { "id": "KXSIG-093", "name": "recon_ffuf_wordlist",                "severity": "low",      "category": "recon",             "patterns": ["(?i)ffuf\\s+.*-w\\s+"] },
    { "id": "KXSIG-094", "name": "obfuscation_high_entropy_base64",    "severity": "medium",   "category": "defense-evasion",   "patterns": ["([A-Za-z0-9+/]{80,}={0,2})"] },
    { "id": "KXSIG-095", "name": "obfuscation_char_join",              "severity": "medium",   "category": "defense-evasion",   "patterns": ["(?i)\\[char\\]\\d{2,3}\\s*\\+\\s*\\[char\\]\\d{2,3}"] },
    { "id": "KXSIG-096", "name": "obfuscation_reverse_string",         "severity": "medium",   "category": "defense-evasion",   "patterns": ["(?i)\\[array\\]::reverse", "(?i)\\.reverse\\(\\)\\.join\\("] },
